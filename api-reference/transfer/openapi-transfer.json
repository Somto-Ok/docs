{
  "openapi": "3.0.1",
  "info": {
    "title": "Kele API",
    "description": "A sample API that uses a plant store as an example to demonstrate features in the OpenAPI specification",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://corebanking-staging.boldmfb.com/api"
    }
  ],
  "security": [
    {
      "apiKeyAuth": [],
      "secretKeyAuth": []
    }
  ],
  "paths": {
    "/payout": {
      "post": {
        "description": "Process a Payout",
        "requestBody": {
          "description": "Process a payout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Payout successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },   
    "/payout/bulk": {
      "post": {
        "description": "Process Bulk Payout",
        "requestBody": {
          "description": "Request a bulk payout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Bulk payout successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkPayoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }, 
    "/payout/resolve": {
      "post": {
        "description": "Resolve Account",
        "requestBody": {
          "description": "Request account",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account successfully resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/intra-payout": {
      "post": {
        "description": "Process Intra Payout",
        "requestBody": {
          "description": "Process an intra payout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntraPayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Intra payout successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payout/intra-bulk": {
      "post": {
        "description": "Process Intra Bulk Payout",
        "requestBody": {
          "description": "Process an intra bulk payout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntraBulkPayoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Intra bulk payout successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payout/intra-resolve": {
      "post": {
        "description": "Resolve Intra Account",
        "requestBody": {
          "description": "Resolve an intra account",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntraResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Intra account successfully resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payout/recurring": {
      "post": {
        "description": "Create a recurring payout",
        "requestBody": {
          "description": "Request to create a recurring payout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecurringRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Recurring payout successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRecurringResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "description": "Get details of recurring payouts",
        "responses": {
          "200": {
            "description": "Recurring payout details successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRecurringResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payout/recurring/2": {
      "put": {
        "description": "Individual Account",
        "requestBody": {
          "description": "Request an individual virtual account",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Success"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Individual corporate account successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/payout/banks": {
      "get": {
        "description": "Get Bank List",
        "responses": {
          "200": {
            "description": "Bank List gotten successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListBankResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PayoutRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "The amount of money to be paid out."
          },
          "sender": {
            "type": "string",
            "description": "The name of the sender initiating the payout."
          },
          "accountName": {
            "type": "string",
            "description": "The name associated with the payout account."
          },
          "accountNumber": {
            "type": "string",
            "pattern": "^[0-9]{10}$",
            "description": "The account number for the payout, must be 10 digits."
          },
          "bankCode": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "description": "The code of the bank associated with the account, must be 3 digits."
          }
        },
        "required": ["amount", "sender", "accountName", "accountNumber", "bankCode"]
      },  
      "PayoutResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Indicates whether the payout request was successful."
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "The status code of the payout response."
          },
          "data": {
            "type": "object",
            "properties": {
              "uniqueIdentity": {
                "type": "string",
                "format": "uuid",
                "description": "A unique identifier for the payout transaction."
              },
              "userIdentity": {
                "type": "string",
                "format": "uuid",
                "description": "The identifier for the user associated with the payout."
              },
              "productType": {
                "type": "string",
                "description": "The type of product associated with the payout."
              },
              "amount": {
                "type": "string",
                "description": "The total amount being paid out."
              },
              "netAmount": {
                "type": "string",
                "description": "The net amount after any deductions."
              },
              "fee": {
                "type": "string",
                "description": "The fee applied to the payout."
              },
              "commission": {
                "type": "string",
                "description": "The commission charged for the payout."
              },
              "transactionAccount": {
                "type": "string",
                "description": "The account used for the transaction."
              },
              "transactionStatusCode": {
                "type": "string",
                "description": "The status code of the transaction."
              },
              "transactionStatus": {
                "type": "string",
                "description": "The current status of the transaction."
              },
              "transactionReference": {
                "type": "string",
                "description": "The reference number for the transaction."
              },
              "beneficiaryName": {
                "type": "string",
                "description": "The name of the beneficiary receiving the payout."
              },
              "beneficiaryNumber": {
                "type": "string",
                "pattern": "^[0-9]{10}$",
                "description": "The beneficiary's account number, must be 10 digits."
              },
              "beneficiaryPlatform": {
                "type": "string",
                "description": "The platform used by the beneficiary."
              },
              "senderName": {
                "type": "string",
                "description": "The name of the sender."
              },
              "senderNumber": {
                "type": "string",
                "description": "The contact number of the sender."
              },
              "senderPlatform": {
                "type": "string",
                "description": "The platform used by the sender."
              },
              "transactionType": {
                "type": "string",
                "description": "The type of transaction performed."
              },
              "comment": {
                "type": "string",
                "description": "Any comments or notes related to the payout."
              },
              "sessionId": {
                "type": "string",
                "description": "The session identifier for the transaction."
              }
            }
          },
          "message": {
            "type": "string",
            "description": "A message providing additional information about the payout response."
          }
        }
      },
      "BulkPayoutRequest": {
        "type": "object",
        "properties": {
          "payouts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "integer",
                  "description": "The amount to be paid out in each transaction."
                },
                "sender": {
                  "type": "string",
                  "description": "The name of the sender initiating the bulk payout."
                },
                "accountName": {
                  "type": "string",
                  "description": "The name associated with each payout account."
                },
                "accountNumber": {
                  "type": "string",
                  "pattern": "^[0-9]{10}$",
                  "description": "The account number for each payout, must be 10 digits."
                },
                "bankCode": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$",
                  "description": "The code of the bank associated with each account, must be 3 digits."
                }
              },
              "required": [
                "amount",
                "sender",
                "accountName",
                "accountNumber",
                "bankCode"
              ]
            }
          }
        },
        "required": ["payouts"]
      },  
      "BulkPayoutResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Indicates whether the bulk payout request was successful."
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "The status code of the bulk payout response."
          },
          "data": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "integer",
                "description": "The identifier for the user who requested the bulk payout."
              },
              "total_count": {
                "type": "integer",
                "description": "The total number of payouts requested."
              },
              "type": {
                "type": "string",
                "description": "The type of bulk payout."
              },
              "wallet_id": {
                "type": "integer",
                "description": "The identifier for the wallet associated with the payouts."
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the bulk payout was last updated."
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the bulk payout was created."
              },
              "id": {
                "type": "integer",
                "description": "The identifier for the bulk payout request."
              },
              "total_processed": {
                "type": "integer",
                "description": "The total number of payouts that have been processed."
              },
              "description": {
                "type": "string",
                "description": "A description of the bulk payout."
              }
            }
          },
          "message": {
            "type": "string",
            "description": "A message providing additional information about the bulk payout response."
          }
        }
      },
      "ResolveRequest": {
        "type": "object",
        "properties": {
          "bankCode": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "example": "033",
            "description": "The code of the bank to resolve, must be 3 digits."
          },
          "accountNumber": {
            "type": "string",
            "pattern": "^[0-9]{10}$",
            "example": "2130703419",
            "description": "The account number to resolve, must be 10 digits."
          }
        },
        "required": ["bankCode", "accountNumber"]
      },  
      "ResolveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Indicates whether the resolution request was successful."
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "The status code of the resolution response."
          },
          "data": {
            "type": "object",
            "properties": {
              "accountNumber": {
                "type": "string",
                "example": "1010101010",
                "description": "The resolved account number."
              },
              "accountName": {
                "type": "string",
                "example": "Customer Name",
                "description": "The name associated with the resolved account."
              },
              "bankName": {
                "type": "string",
                "example": "GTBank Plc",
                "description": "The name of the bank associated with the resolved account."
              },
              "bankCode": {
                "type": "string",
                "example": "058",
                "description": "The code of the bank associated with the resolved account."
              }
            }
          },
          "message": {
            "type": "string",
            "example": "Action was Successful",
            "description": "A message providing additional information about the resolution response."
          }
        }
      },
      "IntraPayoutRequest": {
        "type": "object",
        "properties": {
          "walletNo": {
            "type": "string",
            "nullable": true,
            "description": "The wallet number from which payouts will be made."
          },
          "payouts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountOrPhoneNumber": {
                  "type": "string",
                  "description": "The account number or phone number of the recipient."
                },
                "amount": {
                  "type": "integer",
                  "description": "The amount to be paid out."
                }
              },
              "required": ["accountOrPhoneNumber", "amount"]
            },
            "description": "A list of payouts to be processed."
          }
        },
        "required": ["payouts"]
      },
      "IntraBulkPayoutRequest": {
        "type": "object",
        "properties": {
          "accountOrPhoneNumber": {
            "type": "string",
            "description": "The account number or phone number for the bulk payout."
          }
        },
        "required": ["accountOrPhoneNumber"]
      },
      "IntraResolveRequest": {
        "type": "object",
        "properties": {
          "accountOrPhoneNumber": {
            "type": "string",
            "description": "The account number or phone number to be resolved."
          },
          "amount": {
            "type": "integer",
            "description": "The amount associated with the resolution."
          },
          "walletNo": {
            "type": "string",
            "nullable": true,
            "description": "The wallet number related to the account or phone number."
          }
        },
        "required": ["accountOrPhoneNumber", "amount"]
      },
      "CreateRecurringRequest": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "The date when the recurring transaction starts."
          },
          "circle": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly"],
            "description": "The frequency of the recurring transaction."
          },
          "destination": {
            "type": "string",
            "enum": ["bank_account", "wallet"],
            "description": "The destination type for the payout."
          },
          "bankCode": {
            "type": "string",
            "description": "The code of the bank for the transaction."
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "description": "The amount to be paid out in each recurrence."
          },
          "accountOrPhoneNumber": {
            "type": "string",
            "description": "The account number or phone number of the recipient."
          },
          "isTotal": {
            "type": "boolean",
            "description": "Indicates if the recurring payment is a total payment."
          }
        },
        "required": [
          "startDate",
          "circle",
          "destination",
          "bankCode",
          "amount",
          "accountOrPhoneNumber",
          "isTotal"
        ]
      },
      "CreateRecurringResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Indicates whether the recurring request was successful."
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "The status code of the response."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The unique identifier for the recurring transaction."
              },
              "user_id": {
                "type": "integer",
                "description": "The identifier for the user who created the recurring request."
              },
              "wallet_id": {
                "type": "integer",
                "description": "The identifier for the wallet associated with the recurring request."
              },
              "amount": {
                "type": "string",
                "format": "decimal",
                "description": "The amount set for the recurring payment."
              },
              "start_date": {
                "type": "string",
                "format": "date",
                "description": "The date when the recurring transaction starts."
              },
              "end_date": {
                "type": "string",
                "format": "date",
                "description": "The date when the recurring transaction ends."
              },
              "last_settlement_date": {
                "type": "string",
                "format": "date",
                "description": "The date when the last payment was settled."
              },
              "next_settlement_date": {
                "type": "string",
                "format": "date",
                "description": "The date when the next payment will be settled."
              },
              "circle": {
                "type": "string",
                "description": "The frequency of the recurring transaction."
              },
              "destination": {
                "type": "string",
                "description": "The destination type for the payout."
              },
              "product_type": {
                "type": "string",
                "description": "The type of product associated with the recurring transaction."
              },
              "bank_code": {
                "type": "string",
                "description": "The code of the bank for the transaction."
              },
              "bank_name": {
                "type": "string",
                "description": "The name of the bank for the transaction."
              },
              "account_name": {
                "type": "string",
                "description": "The name of the account holder."
              },
              "account_phone_number": {
                "type": "string",
                "description": "The phone number associated with the account."
              },
              "is_active": {
                "type": "boolean",
                "description": "Indicates if the recurring transaction is active."
              },
              "is_total": {
                "type": "boolean",
                "description": "Indicates if the recurring payment is a total payment."
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the recurring transaction was created."
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the recurring transaction was last updated."
              }
            }
          },
          "message": {
            "type": "string",
            "description": "A message providing additional information about the recurring response."
          }
        }
      },
      "GetRecurringResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "description": "Indicates whether the request was successful."
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "The status code of the response."
          },
          "data": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer",
                "format": "int32",
                "description": "The current page number of the results."
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int32",
                      "description": "The unique identifier for the recurring transaction."
                    },
                    "user_id": {
                      "type": "integer",
                      "format": "int32",
                      "description": "The identifier for the user associated with the transaction."
                    },
                    "wallet_id": {
                      "type": "integer",
                      "format": "int32",
                      "description": "The identifier for the wallet associated with the transaction."
                    },
                    "amount": {
                      "type": "string",
                      "description": "The amount set for the recurring payment."
                    },
                    "start_date": {
                      "type": "string",
                      "format": "date",
                      "description": "The date when the recurring transaction starts."
                    },
                    "end_date": {
                      "type": "string",
                      "format": "date",
                      "description": "The date when the recurring transaction ends."
                    },
                    "last_settlement_date": {
                      "type": "string",
                      "format": "date",
                      "description": "The date when the last payment was settled."
                    },
                    "next_settlement_date": {
                      "type": "string",
                      "format": "date",
                      "description": "The date when the next payment will be settled."
                    },
                    "circle": {
                      "type": "string",
                      "description": "The frequency of the recurring transaction."
                    },
                    "destination": {
                      "type": "string",
                      "description": "The destination type for the payout."
                    },
                    "product_type": {
                      "type": "string",
                      "description": "The type of product associated with the recurring transaction."
                    },
